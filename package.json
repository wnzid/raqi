{
  "name": "footwear-commerce",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @footwear/shared build && concurrently --kill-others --names api,web \"pnpm dev:api\" \"pnpm wait:api && pnpm dev:web\"",
    "wait:api": "wait-on --timeout 60000 http-get://localhost:4000/api/health/live",
    "dev:web": "pnpm --filter @footwear/web dev",
    "dev:api": "pnpm --filter @footwear/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @footwear/shared --filter @footwear/api --filter @footwear/web test",
    "test:e2e": "pnpm --filter @footwear/e2e test",
    "db:generate": "pnpm --filter @footwear/database db:generate",
    "db:migrate": "pnpm --filter @footwear/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @footwear/database db:migrate:deploy",
    "db:studio": "pnpm --filter @footwear/database db:studio",
    "db:seed": "pnpm --filter @footwear/database db:seed",
    "bootstrap:super-admin": "pnpm --filter @footwear/api bootstrap:super-admin"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prisma": "6.15.0",
    "wait-on": "^9.1.0"
  }
}
